{
  "name": "relayctx",
  "version": "1.0.0",
  "description": "Persist and restore structured AI coding context across sessions, IDEs, devices, and team members.",
  "type": "module",
  "bin": {
    "relayctx": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "context",
    "cli",
    "git",
    "developer-tools",
    "productivity",
    "cursor",
    "copilot",
    "claude"
  ],
  "author": "Syed Danish Ali",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "clipboardy": "^4.0.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.3.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
